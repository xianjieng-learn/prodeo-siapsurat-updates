{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xianjieng-learn/prodeo-siapsurat-updates/main/schemas/update-manifest.schema.json",
  "title": "Prodeo SIAPSurat update channel manifest",
  "type": "object",
  "required": [
    "schema",
    "name",
    "channel",
    "version",
    "minimum_version",
    "package_format",
    "published_at",
    "download_url",
    "sha256",
    "size",
    "notes"
  ],
  "properties": {
    "schema": {"type": "integer", "const": 1},
    "name": {"type": "string", "minLength": 1},
    "channel": {"type": "string", "enum": ["stable"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "minimum_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "package_format": {"type": "integer", "minimum": 2},
    "published_at": {"type": "string", "format": "date-time"},
    "download_url": {"type": "string", "pattern": "^https://"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "size": {"type": "integer", "minimum": 1},
    "notes": {"type": "array", "items": {"type": "string"}},
    "repository_url": {"type": "string", "pattern": "^https://"}
  },
  "additionalProperties": true
}
